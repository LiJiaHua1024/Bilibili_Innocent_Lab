diff --git a/lumen-engine/src/main/java/com/lumen/coacervation/engine/host/LumenSurfaceLegibilityController.kt b/lumen-engine/src/main/java/com/lumen/coacervation/engine/host/LumenSurfaceLegibilityController.kt
